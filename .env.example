# Copy this file to .env and fill in real values. .env is git-ignored.

# Random secret used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Postgres password for the db service. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# User accounts are no longer a single shared password (APP_PASSWORD_HASH is gone).
# After the app is up, create your first login with:
#   docker compose exec app flask create-user <username> --admin

# Whether the session cookie requires HTTPS. Defaults to true (secure) in the
# app itself. Set to false ONLY if this instance is served over plain http
# with no TLS termination in front of it (e.g. local/personal use) -- otherwise
# browsers silently discard the cookie after login and you'll be bounced back
# to the login page in a loop. Set back to true once served over https.
SESSION_COOKIE_SECURE=false
